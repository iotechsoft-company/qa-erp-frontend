{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--storage-state",
        ".auth/user.json",
        "--secrets",
        ".env",
        "--output-dir",
        "test-results/mcp",
        "--viewport-size",
        "1440x900"
      ]
    }
  }
}
