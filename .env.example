# ─── Target ─────────────────────────────────────────────
# Web URL ของ ERP ที่จะยิงเทส (no trailing slash) — ปัจจุบันเป็น env dev (ยังไม่มี prod)
BASE_URL=https://erp-web.iotechsoft.com
# ชื่อ environment ใช้แสดงใน report (local | dev | uat | prod)
TEST_ENV=dev

# ─── Test accounts (ห้าม commit ค่าจริง) ───────────────────
# สร้าง/rotate อัตโนมัติด้วย `pnpm provision:users` (เขียนค่าลงไฟล์นี้ให้เอง)
E2E_USERNAME=e2e.admin
E2E_PASSWORD=
E2E_STAFF_USERNAME=e2e.staff
E2E_STAFF_PASSWORD=

# Admin ที่มีอยู่แล้ว — ใช้เฉพาะ scripts/provision-test-users.ts เพื่อสร้าง test users
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── Safety ─────────────────────────────────────────────
# เทสที่ tag @mutation จะ create/update/delete ข้อมูลจริง
# dev: true ได้ · ถ้าวันหนึ่งมี prod → ต้องเป็น false เสมอ
ALLOW_MUTATION=false
